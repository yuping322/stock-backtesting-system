OSS_BUCKET_NAME=your_bucket_name_here

# AkShare OSS配置
AKSHARE_OSS_ACCESS_KEY_ID=your_akshare_access_key_id_here
AKSHARE_OSS_ACCESS_KEY_SECRET=your_akshare_access_key_secret_here

# 其他配置
LOG_LEVEL=INFO
